{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "violations.schema.json",
  "title": "Violations",
  "description": "Output produced by principles-auditor: general-purpose qualitative violations, classified by severity.",
  "type": "object",
  "required": ["generated_at", "files_analyzed", "blocking", "important", "nit", "suggestion", "ai_smells", "manual_verify"],
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 generation timestamp"
    },
    "files_analyzed": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of files analysed"
    },
    "blocking": {
      "type": "array",
      "description": "Violations that cause bugs, break a core principle, or are unsafe",
      "items": { "$ref": "#/$defs/violation" }
    },
    "important": {
      "type": "array",
      "description": "Violations that create significant debt or make the code hard to maintain",
      "items": { "$ref": "#/$defs/violation" }
    },
    "nit": {
      "type": "array",
      "description": "Style, minor naming, small cleanups with no impact on maintainability",
      "items": { "$ref": "#/$defs/violation" }
    },
    "suggestion": {
      "type": "array",
      "description": "Optional improvements that are not urgent, or are uncertain",
      "items": { "$ref": "#/$defs/violation" }
    },
    "ai_smells": {
      "type": "array",
      "description": "Patterns generated or amplified by AI, detected from ai-smells.md",
      "items": {
        "type": "object",
        "required": ["file", "rule", "description", "severity"],
        "properties": {
          "file": { "type": "string" },
          "rule": {
            "type": "string",
            "description": "Pattern identifier, e.g. structural-clone, swallowed-errors"
          },
          "description": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["blocking", "important", "nit", "suggestion"]
          }
        },
        "additionalProperties": false
      }
    },
    "manual_verify": {
      "type": "array",
      "description": "Files too risky to modify without test coverage - excluded from automatic refactoring",
      "items": {
        "type": "object",
        "required": ["file", "reason", "recommendation"],
        "properties": {
          "file": { "type": "string" },
          "reason": { "type": "string", "description": "Reason for the manual_verify marking" },
          "recommendation": { "type": "string", "description": "Recommended action before retrying" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "violation": {
      "type": "object",
      "required": ["file", "principle", "description", "fix_hint"],
      "properties": {
        "file": { "type": "string", "description": "Relative path of the file" },
        "line": { "type": "integer", "minimum": 1, "description": "Approximate line of the violation (optional)" },
        "principle": {
          "type": "string",
          "description": "Principle violated, e.g. P1-single-responsibility, P2-single-source-of-truth"
        },
        "description": {
          "type": "string",
          "description": "Precise description of the violation, in natural language"
        },
        "evidence": {
          "type": "string",
          "description": "Code excerpt or concrete fact that proves the violation"
        },
        "fix_hint": {
          "type": "string",
          "description": "Concrete suggestion for a fix"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
